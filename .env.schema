# LLM API credentials for Docker builds.
# Safe to commit: secret keys are resolved at load time via the Infisical
# plugin below — only entry paths are stored here, never values.
# Expected Infisical layout: <ENV_VAR_NAME> (e.g. OPENROUTER_API_KEY)
# @plugin(@varlock/infisical-plugin@2.1.3)
# @initInfisical(projectId=a844d80b-28c4-49a8-9ce4-8354d4cbd2b5, environment=dev, clientId=$INFISICAL_CLIENT_ID, clientSecret=$INFISICAL_CLIENT_SECRET, siteUrl=$INFISICAL_SITE_URL)
# @defaultSensitive=false
# @defaultRequired=true
# ---

# @type=infisicalClientId
INFISICAL_CLIENT_ID=
# @type=infisicalClientSecret @sensitive @internal
INFISICAL_CLIENT_SECRET=
# @type=string
INFISICAL_SITE_URL=

# @sensitive=true
# @required=false
# @type=string(optional=true,startsWith=sk-or-v1-)
# @proxy(domain="openrouter.ai")
# @placeholder=sk-or-v1-vlk-placeholder
OPENROUTER_API_KEY=infisical()

# @sensitive=true
# @required=false
# @type=string(optional=true,startsWith=sk-sp-)
# @proxy(domain="token-plan.maas.qwencloudapi.com")
# @placeholder=sk-sp-vlk-placeholder
DASHSCOPE_API_KEY=infisical(allowMissing=true)

# @sensitive=true
# @required=false
# @type=string(optional=true)
# @proxy(domain="vllm.home.davidandersen.us")
# @placeholder=sk-vlk-placeholder
VLLM_API_KEY=infisical(allowMissing=true)

# @sensitive=true
# @required=false
# @type=string(optional=true)
# @proxy(domain="xestrata.home.davidandersen.us")
XESTRATA_API_KEY=infisical()
